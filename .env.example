# ============================================================
# PlantCare AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with your credentials
# ============================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase API Key (anon public key or service_role secret key for backend)
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Application secret key for cryptographic sessions
PLANTCARE_SECRET_KEY="replace-with-a-secure-random-string"
